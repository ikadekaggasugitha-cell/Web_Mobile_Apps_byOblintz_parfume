# Copy to .env.test and point at a DISPOSABLE Postgres/Redis before running:
#   pnpm --filter @oblintz/api exec prisma migrate deploy   # against DATABASE_URL_TEST
#   pnpm --filter @oblintz/api test:integration
#
# Integration tests are skipped automatically if DATABASE_URL_TEST is unset.

DATABASE_URL_TEST="postgresql://oblintz:password@localhost:5432/oblintz_test"
REDIS_URL_TEST="redis://localhost:6379/1"
JWT_ACCESS_SECRET="test-jwt-secret-min-32-characters!!"
